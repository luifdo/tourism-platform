@startuml CasosDeUso_PlataformaTurismoSantaMarta
!include _estilo.iuml
left to right direction
skinparam defaultFontSize 12
title Casos de uso — Vista general (todos los actores)

actor "Turista" as Tur
actor "Prestador de\nServicios Turísticos" as Prest
actor "Entidad de Gestión\ndel Destino" as Ent
actor "Administrador de\nla Plataforma" as Admin
actor "Sistema / Servicios externos\n(SMTP, API de Gemini)" as Sys

rectangle "Plataforma Digital de Turismo — Santa Marta" {
  package "Módulo 1: Seguridad & IAM" {
    usecase "UC1 · Registrarse (18+)" as UC1
    usecase "UC2 · Iniciar sesión" as UC2
    usecase "UC3 · Recuperar contraseña" as UC3
    usecase "UC4 · Gestionar perfil" as UC4
    usecase "UC6 · Aceptar política de datos" as UC6
    usecase "UC27 · Administrar usuarios y roles" as UC27
    usecase "UC28 · Aprobar / rechazar prestadores" as UC28
    usecase "UC32 · Políticas de seguridad" as UC32
    usecase "UC33 · Consultar bitácora" as UC33
    usecase "UC37 · Cargar documentos RNT / RUT" as UC37
  }
  package "Módulo 2: Catálogo, GIS & Inteligencia de Destino" {
    usecase "UC7 · Consultar catálogo" as UC7
    usecase "UC8 · Buscar y filtrar" as UC8
    usecase "UC9 · Ver detalle de servicio" as UC9
    usecase "UC16 · Ver mapa interactivo" as UC16
    usecase "UC17 · Registrar oferta" as UC17
    usecase "UC18 · Editar servicio" as UC18
    usecase "UC22 · Métricas de su oferta" as UC22
    usecase "UC23 · Indicadores de demanda" as UC23
    usecase "UC24 · Capacidad de carga" as UC24
    usecase "UC25 · Tableros de planificación" as UC25
    usecase "UC26 · Publicar alertas oficiales" as UC26
    usecase "UC36 · Enviar correo de confirmación" as UC36
    usecase "UC38 · Exportar reportes CSV / PDF" as UC38
  }
  package "Módulo 3: Reservas & Cupos" {
    usecase "UC10 · Consultar disponibilidad" as UC10
    usecase "UC11 · Solicitar reserva" as UC11
    usecase "UC12 · Cancelar / modificar reserva" as UC12
    usecase "UC13 · Historial de reservas" as UC13
    usecase "UC19 · Gestionar cupos y tarifas" as UC19
    usecase "UC20 · Confirmar / rechazar solicitudes" as UC20
  }
  package "Módulo 4: Reseñas & Moderación" {
    usecase "UC15 · Calificar y reseñar" as UC15
    usecase "UC21 · Responder reseñas" as UC21
    usecase "UC29 · Moderar reseñas reportadas" as UC29
    usecase "UC39 · Reportar reseña" as UC39
  }
  package "Módulo 5: IA & Recomendación" {
    usecase "UC14 · Recomendaciones (chatbot)" as UC14
  }
  package "Transversal" {
    usecase "UC5 · Cambiar idioma ES / EN" as UC5
    usecase "UC30 · Configurar integraciones" as UC30
    usecase "UC31 · Monitorear telemetría" as UC31
  }
}

Tur --> UC1
Tur --> UC2
Tur --> UC3
Tur --> UC4
Tur --> UC5
Tur --> UC7
Tur --> UC8
Tur --> UC9
Tur --> UC16
Tur --> UC11
Tur --> UC12
Tur --> UC13
Tur --> UC14
Tur --> UC15
Tur --> UC39

Prest --> UC1
Prest --> UC4
Prest --> UC37
Prest --> UC17
Prest --> UC18
Prest --> UC22
Prest --> UC19
Prest --> UC20
Prest --> UC21
Prest --> UC39

UC16 <-- Ent
UC23 <-- Ent
UC24 <-- Ent
UC25 <-- Ent
UC26 <-- Ent

UC27 <-- Admin
UC28 <-- Admin
UC32 <-- Admin
UC33 <-- Admin
UC29 <-- Admin
UC30 <-- Admin
UC31 <-- Admin

UC36 --> Sys
UC14 --> Sys

UC1 ..> UC6 : <<include>>
UC8 ..> UC7 : <<include>>
UC9 ..> UC7 : <<include>>
UC11 ..> UC10 : <<include>>
UC12 ..> UC13 : <<include>>
UC25 ..> UC23 : <<include>>
UC25 ..> UC24 : <<include>>
UC38 ..> UC25 : <<extend>>
UC20 ..> UC36 : <<trigger>>
@enduml
