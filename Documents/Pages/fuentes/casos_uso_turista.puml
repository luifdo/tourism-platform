@startuml CasosDeUso_Turista
!include _estilo.iuml
left to right direction
title Casos de uso — Turista

actor "Turista" as Tur
actor "API de Gemini\n(servicio externo)" as Gem

rectangle "Plataforma Digital de Turismo — Santa Marta" {
  package "Módulo 1: Seguridad & IAM" {
    usecase "UC1 · Registrarse (18+)" as UC1
    usecase "UC6 · Aceptar política\nde datos personales" as UC6
    usecase "UC2 · Iniciar sesión" as UC2
    usecase "UC3 · Recuperar contraseña" as UC3
    usecase "UC4 · Gestionar perfil" as UC4
  }
  package "Transversal" {
    usecase "UC5 · Cambiar idioma ES / EN" as UC5
  }
  package "Módulo 2: Catálogo, GIS & Destino" {
    usecase "UC7 · Consultar catálogo" as UC7
    usecase "UC8 · Buscar y filtrar" as UC8
    usecase "UC9 · Ver detalle de servicio" as UC9
    usecase "UC16 · Ver mapa interactivo" as UC16
  }
  package "Módulo 3: Reservas & Cupos" {
    usecase "UC10 · Consultar disponibilidad" as UC10
    usecase "UC11 · Solicitar reserva" as UC11
    usecase "UC12 · Cancelar / modificar\nsolicitud de reserva" as UC12
    usecase "UC13 · Ver historial de reservas" as UC13
  }
  package "Módulo 4: Reseñas & Moderación" {
    usecase "UC15 · Calificar y reseñar" as UC15
    usecase "UC39 · Reportar reseña" as UC39
  }
  package "Módulo 5: IA & Recomendación" {
    usecase "UC14 · Recibir recomendaciones\n(chatbot)" as UC14
  }
}

Tur --> UC1
Tur --> UC2
Tur --> UC3
Tur --> UC4
Tur --> UC5
Tur --> UC7
Tur --> UC8
Tur --> UC9
Tur --> UC16
Tur --> UC11
Tur --> UC12
Tur --> UC13
Tur --> UC15
Tur --> UC39
Tur --> UC14

UC1 ..> UC6 : <<include>>
UC8 ..> UC7 : <<include>>
UC9 ..> UC7 : <<include>>
UC11 ..> UC10 : <<include>>
UC12 ..> UC13 : <<include>>
UC14 --> Gem

note bottom of UC15
  Precondición: el turista tiene una
  reserva Finalizada del servicio.
end note
note bottom of UC12
  Modificar solo mientras la
  reserva está Solicitada.
end note
@enduml
