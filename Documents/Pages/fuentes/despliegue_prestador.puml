@startuml Diagrama_Despliegue_Prestador
!include _estilo_despliegue.iuml
left to right direction
title Despliegue — Vista del Prestador de Servicios Turísticos

actor "Prestador" as Pre
node "Dispositivo del prestador\n(conexión intermitente)" {
  artifact "PWA\n(formularios pendientes\nen IndexedDB)" as PWA
}
node "Clúster k3s" {
  artifact "Traefik" as Tfk
  artifact "iam-service" as Iam
  artifact "catalog-service" as Cat
  artifact "booking-service" as Book
  artifact "review-service" as Rev
  queue "RabbitMQ" as Rmq
  database "PostgreSQL\n(iam_db, catalog_db,\nbooking_db, review_db)" as Pg
  database "SeaweedFS\n(RNT / RUT)" as Sw
}
cloud "Servicios externos" {
  node "Servidor SMTP" as Smtp
}

Pre --> PWA
PWA --> Tfk : HTTPS (envío diferido)
Tfk --> Iam : registro y documentos
Tfk --> Cat : oferta
Tfk --> Book : cupos y solicitudes
Tfk --> Rev : respuestas a reseñas
Iam --> Sw
Iam --> Pg
Cat --> Pg
Book --> Pg
Rev --> Pg
Book --> Rmq : reserva.*
Rmq --> Cat : correos
Cat --> Smtp : SMTP/TLS
@enduml
