{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reserva.finalizada.v1.json",
  "title": "reserva.finalizada (payload v1)",
  "description": "Publicado por booking-service cuando pasa la fecha de una reserva confirmada (tarea programada). Habilita la reseña del turista en review-service (RF-14) y registra la ocupación efectiva en catalog-service.",
  "type": "object",
  "required": ["reserva_id", "servicio_id", "turista_id", "prestador_id", "fecha_reserva", "numero_personas"],
  "properties": {
    "reserva_id": { "type": "string", "format": "uuid" },
    "servicio_id": { "type": "string", "format": "uuid" },
    "turista_id": { "type": "string", "format": "uuid" },
    "prestador_id": { "type": "string", "format": "uuid" },
    "fecha_reserva": { "type": "string", "format": "date" },
    "numero_personas": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}
