# Copiar a infra/.env antes de levantar el entorno (infra/.env no se sube al repositorio)
POSTGRES_USER=turismo
POSTGRES_PASSWORD=cambiar-en-local
RABBITMQ_DEFAULT_USER=turismo
RABBITMQ_DEFAULT_PASS=turismo
GRAFANA_ADMIN_PASSWORD=cambiar-en-local
# iam-service: contraseña de su rol propio en iam_db
IAM_DB_PASSWORD=cambiar-en-local
# iam-service: primer Admin (solo se crea si no existe)
ADMIN_EMAIL=admin@turismo.local
ADMIN_PASSWORD=Cambiar-en-local1
ADMIN_NOMBRE="Administrador local"
# catalog-service: secreto de la sal diaria del hash del IP (intención de visita)
CATALOG_INTENCION_VISITA_SECRETO=cambiar-en-local
# recommendation-service: clave de Groq; sin ella el chat responde 503 y lo demás funciona
LLM_API_KEY=

# Direcciones que ve el navegador. Comentadas = las de desarrollo local (localhost). En un servidor
# van con el dominio público; el host de S3 debe ser el mismo del Host de SeaweedFS en gateway/config.
# S3_ENDPOINT_PUBLICO=https://s3.3-141-142-12.sslip.io
# IMAGENES_URL_PUBLICA=https://s3.3-141-142-12.sslip.io/catalogo-imagenes
# PWA_URL=https://3-141-142-12.sslip.io

# HTTPS (Traefik + Let's Encrypt), solo en el servidor. Se activa sumando docker-compose.https.yml; con COMPOSE_FILE
# basta `docker compose up -d`. Necesita los puertos 80 Y 443 abiertos a todo internet (reto HTTP-01).
# COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml
# DOMINIO_PUBLICO es el dominio de la PWA SIN https://; el certificado cubre también s3.<dominio>. Debe coincidir con las
# tres direcciones de arriba. Lo lee además la lista de CORS del host s3 (gateway/config/compose/00-middlewares.yml).
# DOMINIO_PUBLICO=3-141-142-12.sslip.io
# ACME_EMAIL=correo-real@dominio.com
# Para PROBAR sin gastar el límite de Let's Encrypt (sslip.io lo comparte con todos sus usuarios), primero staging; el
# navegador lo marca como no confiable. Después se quita y se borra el volumen traefik-acme para pedir el real:
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# IP en la que se publican todos los puertos menos el 80 (Postgres, RabbitMQ, servicios 8001-8005...).
# Comentada = 127.0.0.1, solo este equipo. 0.0.0.0 = también la red local; nunca en un servidor.
# PUERTOS_INTERNOS_IP=0.0.0.0

# Correo de iam y catalog. Comentadas = Mailpit (http://localhost:8025), que atrapa todos los correos.
# Para enviar de verdad: un proveedor SMTP por el puerto 587 con STARTTLS (AWS bloquea el 25 de salida).
# SMTP_HOST=smtp.proveedor.com
# SMTP_PORT=587
# SMTP_USUARIO=
# SMTP_CLAVE=
# SMTP_STARTTLS=true
# SMTP_REMITENTE="Turismo Santa Marta <no-responder@dominio-verificado.com>"
