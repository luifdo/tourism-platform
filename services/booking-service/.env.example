# Variables de entorno de booking-service (copiar a .env; nunca subir .env al repositorio)
SERVICE_PORT=8003
# RabbitMQ (solo en modo postgres). Local: python scripts/rabbitmq_pruebas.py subir (puerto 5673).
RABBITMQ_URL=amqp://booking:booking@127.0.0.1:5673/
EVENTS_EXCHANGE=turismo.eventos
# Relay del outbox: eventos por vuelta y segundos de espera cuando no hay pendientes.
RELAY_LOTE=100
RELAY_ESPERA_S=1
PLAZO_RESPUESTA_HORAS=48
# memoria: sin Postgres ni RabbitMQ (pruebas y demo). postgres: booking_db real.
MODO_PERSISTENCIA=memoria
# Postgres de booking (driver asíncrono asyncpg). Local: puerto 5433 para no chocar con un Postgres del PC.
DATABASE_URL=postgresql+asyncpg://booking:booking@127.0.0.1:5433/booking_db
DB_POOL_TAMANO=10
DB_POOL_EXTRA=5
DB_POOL_ESPERA_S=5
# Solo en modo memoria: servicio de ejemplo y rutas /dev para la demo en Swagger.
DATOS_DEMO=true
