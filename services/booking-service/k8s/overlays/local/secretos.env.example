# Copiar a secretos.env (no se sube). Credenciales de infra/.env; host.docker.internal es tu
# máquina vista desde los pods. booking_db la crea infra/postgres/init.
DATABASE_URL=postgresql+asyncpg://turismo:cambiar-en-local@host.docker.internal:5432/booking_db
RABBITMQ_URL=amqp://turismo:turismo@host.docker.internal:5672/
# Base 1 de Valkey: separada de la caché de catalog (base 0).
VALKEY_URL=redis://host.docker.internal:6379/1

