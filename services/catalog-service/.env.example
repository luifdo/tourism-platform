# Variables de entorno de catalog-service (copiar a .env; nunca subir .env al repositorio)
SERVICE_PORT=8002
ENVIRONMENT=development
LOG_LEVEL=INFO

# Valores para correr uvicorn en local contra los contenedores de docker-compose.dev.yml.
# Usan puertos distintos a los de iam-service para poder levantar ambos a la vez.
# Dentro de Docker/k8s los hosts son postgres, valkey y rabbitmq, con sus puertos estándar.
DATABASE_URL=postgresql+asyncpg://catalog_user:catalog_password@localhost:5434/catalog_db
VALKEY_URL=redis://localhost:6380/0
# Si Valkey no responde en este tiempo, la búsqueda sigue sin caché.
VALKEY_TIMEOUT_SECONDS=0.25

RABBITMQ_URL=amqp://guest:guest@localhost:5673/
EVENTS_EXCHANGE=turismo.eventos

# Worker (python -m app.worker): relay del outbox hacia RabbitMQ.
OUTBOX_LOTE=100
OUTBOX_INTERVALO_SEGUNDOS=1.0
OUTBOX_ESPERA_MAXIMA_SEGUNDOS=30
OUTBOX_RETENCION_DIAS=7
WORKER_METRICS_PORT=9102
# Consumidores (catalog.prestadores...): mensajes en proceso a la vez por cola.
CONSUMIDOR_PREFETCH=10

# Intención de visita: secreto de la sal diaria del hash del IP (en producción, un Secret).
INTENCION_VISITA_SECRETO=desarrollo-cambiar-en-produccion

# Correos de reservas (worker): contacto en iam (ruta interna) y SMTP.
# En desarrollo, Mailpit (docker-compose.dev.yml) los muestra en http://localhost:8026.
IAM_URL_INTERNA=http://localhost:8001
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_STARTTLS=false
SMTP_REMITENTE=Turismo Santa Marta <no-responder@turismo-santamarta.local>

# Imágenes en SeaweedFS (credenciales de desarrollo de dev/seaweedfs-s3.json).
S3_ENDPOINT_PUBLICO=http://localhost:8333
S3_ACCESS_KEY=catalog_access_dev
S3_SECRET_KEY=catalog_secret_dev
S3_BUCKET_IMAGENES=catalogo-imagenes
IMAGENES_URL_PUBLICA=http://localhost:8333/catalogo-imagenes

# Nominatim: un correo de contacto ayuda a que no bloqueen la app si hay un problema.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_EMAIL=
