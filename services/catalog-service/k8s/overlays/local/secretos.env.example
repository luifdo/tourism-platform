# Copiar a secretos.env (no se sube). Valores de infra/.env.example: si cambiaste infra/.env,
# usa aquí las mismas credenciales. host.docker.internal es tu máquina vista desde los pods.
DATABASE_URL=postgresql+asyncpg://turismo:cambiar-en-local@host.docker.internal:5432/catalog_db
VALKEY_URL=redis://host.docker.internal:6379/0
RABBITMQ_URL=amqp://turismo:turismo@host.docker.internal:5672/
S3_ACCESS_KEY=catalog_access_dev
S3_SECRET_KEY=catalog_secret_dev
SMTP_USUARIO=
SMTP_CLAVE=
INTENCION_VISITA_SECRETO=cambiar-en-local
