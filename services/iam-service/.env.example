# Variables de entorno de iam-service (copiar a .env; nunca subir .env al repositorio)
SERVICE_PORT=8001
ENVIRONMENT=development
# IPs o rangos de los proxies de confianza (Traefik). Solo de ellos se acepta X-Forwarded-For.
FORWARDED_ALLOW_IPS=127.0.0.1

# Valores para correr uvicorn en local contra los contenedores de docker-compose.dev.yml.
# Dentro de Docker/k8s los hosts son postgres, valkey, rabbitmq y seaweedfs, y Postgres usa el puerto 5432.
DATABASE_URL=postgresql+asyncpg://iam_user:iam_password@localhost:5433/iam_db
# Rol de la app al que la migración inicial le revoca UPDATE/DELETE/TRUNCATE en bitacora_auditoria
DB_APP_ROLE=iam_user
VALKEY_URL=redis://localhost:6379/0

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
EVENTS_EXCHANGE=turismo.eventos
RABBITMQ_TIMEOUT_SECONDS=5
# Mensajes que el worker procesa a la vez en iam.auditoria
CONSUMIDOR_PREFETCH=10
# Tope de la espera creciente si RabbitMQ no responde al arrancar el worker
RABBITMQ_ESPERA_MAXIMA_SEGUNDOS=30

# Worker (python -m app.worker): /metrics y sonda de vida
WORKER_METRICS_PORT=9101
LOG_LEVEL=INFO

S3_ENDPOINT_URL=http://localhost:8333
S3_ENDPOINT_PUBLICO=http://localhost:8333
S3_REGION=us-east-1
# Valores de desarrollo: el SeaweedFS de docker-compose.dev.yml acepta cualquier credencial.
# En k3s las provee infra/ (C-46).
S3_ACCESS_KEY=iam_access_dev
S3_SECRET_KEY=iam_secret_dev
S3_BUCKET=documentos-verificacion

# Correos de recuperación (C-28). En desarrollo, Mailpit (interfaz en http://localhost:8025).
# En k3s: SMTP_TLS=true (STARTTLS) y SMTP_USUARIO y SMTP_PASSWORD desde un Secret.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Turismo Santa Marta <no-responder@turismo-santamarta.local>
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_TLS=false
# Base del enlace del correo; nunca se arma con el Host de la petición.
PWA_URL=http://localhost:5173

JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ACCESS_TOKEN_TTL_MINUTES=15

# Hashes Argon2 simultáneos por réplica; cada uno reserva 64 MiB (C-53)
ARGON2_CONCURRENCIA_MAXIMA=4
# Tope de la espera por un cupo; si se pasa, 503 SERVICIO_OCUPADO con Retry-After
ARGON2_ESPERA_MAXIMA_SEGUNDOS=10

# Primer Admin (scripts/seed_admin.py)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=
