# Copiar a secretos.env (no se sube). Valores de desarrollo de docker-compose.dev.yml: nada real.
# host.docker.internal es tu máquina vista desde los pods.
DATABASE_URL=postgresql+asyncpg://iam_user:iam_password@host.docker.internal:5433/iam_db
VALKEY_URL=redis://host.docker.internal:6379/0
RABBITMQ_URL=amqp://guest:guest@host.docker.internal:5672/
S3_ACCESS_KEY=iam_access_dev
S3_SECRET_KEY=iam_secret_dev
SMTP_USUARIO=
SMTP_PASSWORD=
