# Variables de recommendation-service (copiar a .env; nunca subir .env al repositorio)
SERVICE_PORT=8005

# Base de datos propia (Fase 1)
DB_URL=postgresql+psycopg://turismo:turismo@postgres:5432/recommendation_db

# Sesiones del chat, TTL de 24 h (Fase 1)
VALKEY_URL=redis://valkey:6379/0

# Servicios que consultan las tools; en local apuntan al mock (Fase 2)
CATALOG_URL=http://mock-plataforma:9000/api/catalog
BOOKING_URL=http://mock-plataforma:9000/api/bookings
REVIEW_URL=http://mock-plataforma:9000/api/reviews
# Tiempo máximo de cada llamada de una tool, en segundos
HERRAMIENTAS_TIMEOUT_SEGUNDOS=5

# Proveedor de IA: Groq (Fase 5). En k3s la clave viene de un Secret y el modelo de un ConfigMap.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Esfuerzo de razonamiento (modelos gpt-oss): low gasta menos tokens; vacío = no se envía
LLM_REASONING_EFFORT=low
# Tiempo máximo de una consulta completa al chat (modelo + tools), en segundos
CHAT_TIMEOUT_SEGUNDOS=45
# Mensajes que puede enviar cada turista por ventana (cuida la cuota del proveedor)
CHAT_LIMITE_MENSAJES=10
CHAT_LIMITE_VENTANA_SEGUNDOS=300
