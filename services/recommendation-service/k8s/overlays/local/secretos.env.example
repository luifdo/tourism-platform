# Copiar a secretos.env (no se sube). Credenciales de infra/.env; host.docker.internal es tu
# máquina vista desde los pods. recommendation_db la crea infra/postgres/init.
DB_URL=postgresql+psycopg://turismo:cambiar-en-local@host.docker.internal:5432/recommendation_db
# Base 3 de Valkey (catalog 0, booking 1, iam 2).
VALKEY_URL=redis://host.docker.internal:6379/3
# Sin clave el servicio arranca igual, pero el chat responde 503. La clave de Groq nunca se sube.
LLM_API_KEY=
