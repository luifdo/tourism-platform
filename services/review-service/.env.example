# Variables de entorno de review-service (copiar a .env; nunca subir .env al repositorio)
SERVICE_PORT=8004
ENVIRONMENT=development
LOG_LEVEL=INFO

# Valores para correr uvicorn en local contra los contenedores de docker-compose.dev.yml.
# Usan puertos distintos a los de iam-service y catalog-service para poder levantarlos a la vez.
# Dentro de Docker/k8s los hosts son postgres y rabbitmq, con sus puertos estándar.
DATABASE_URL=postgresql+asyncpg://review_user:review_password@localhost:5435/review_db

RABBITMQ_URL=amqp://guest:guest@localhost:5674/
RABBITMQ_TIMEOUT_SECONDS=5
EVENTS_EXCHANGE=turismo.eventos

# Worker (python -m app.worker): relay del outbox y consumidores.
OUTBOX_LOTE=100
OUTBOX_INTERVALO_SEGUNDOS=1.0
OUTBOX_ESPERA_MAXIMA_SEGUNDOS=30
OUTBOX_RETENCION_DIAS=7
WORKER_METRICS_PORT=9104
# Consumidores (review.elegibilidad, review.servicios): mensajes en proceso a la vez por cola.
CONSUMIDOR_PREFETCH=10
