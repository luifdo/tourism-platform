# Copiar a secretos.env (no se sube). Credenciales de infra/.env; host.docker.internal es tu
# máquina vista desde los pods. Cambia <tu_db> por la base del servicio (infra/postgres/init).
DATABASE_URL=postgresql+asyncpg://turismo:cambiar-en-local@host.docker.internal:5432/<tu_db>
RABBITMQ_URL=amqp://turismo:turismo@host.docker.internal:5672/
